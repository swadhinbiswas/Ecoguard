# ── Application ────────────────────────────────────────────────
APP_NAME=Eco-Guard
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ecoguard
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
AUTO_MIGRATE=false

# ── Model ─────────────────────────────────────────────────────
MODEL_PATH=./models/tinyllama.gguf
MODEL_N_CTX=2048
MODEL_N_THREADS=4
MODEL_N_BATCH=512
BACKEND=llama-cpp
BACKEND_URL=http://localhost:8001
BACKEND_API_KEY=
BACKEND_MODEL=

# ── Redis (enables multi-worker rate limiting) ────────────────
REDIS_URL=

# ── Security ──────────────────────────────────────────────────
MAX_INPUT_CHARS=4000
CORS_ORIGINS=["*"]
IP_ALLOWLIST=[]

# ── Authentication (all required in production) ───────────────
AUTH_ENABLED=true
API_KEYS=[]
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── SSO/OIDC ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Demo Mode ─────────────────────────────────────────────────
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
DEMO_READ_ONLY=true
DEMO_ALLOW_INFERENCE=false

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Caching ───────────────────────────────────────────────────
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# ── Guardrails ────────────────────────────────────────────────
GUARDRAILS_ENABLED=false

# ── Request Protection ────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=120
CIRCUIT_BREAKER_ENABLED=true
MAX_CONCURRENT_INFERENCE=4
SHUTDOWN_DRAIN_TIMEOUT=15.0

# ── Model Warmup ──────────────────────────────────────────────
MODEL_WARMUP_ENABLED=true
MODEL_WARMUP_PROMPT=Hello

# ── Drift & Retraining ────────────────────────────────────────
DRIFT_WINDOW_SIZE=100
DRIFT_MIN_SAMPLES=10
DRIFT_ALERT_THRESHOLD=0.8
ALERTING_WEBHOOK_URL=

# ── Monitoring ────────────────────────────────────────────────
METRICS_ENABLED=true
OTLP_ENDPOINT=

# ── Database Retry ────────────────────────────────────────────
DB_MAX_RETRIES=5
DB_RETRY_BASE_DELAY=0.5

# ── GitOps ────────────────────────────────────────────────────
# Place ecoguard.yaml at project root for auto-reload
